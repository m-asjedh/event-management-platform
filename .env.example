# Copy to .env only if you want to change something.
# docker-compose.yml has these same values as defaults, so the stack starts
# with no .env file at all.
#
# Changing POSTGRES_USER, POSTGRES_PASSWORD or POSTGRES_DB after the database
# has been created has no effect: PostgreSQL only reads them when it
# initialises an empty data directory. Run `make reset` first.

POSTGRES_USER=emp_user
POSTGRES_PASSWORD=emp_password
POSTGRES_DB=event_management_platform
POSTGRES_PORT=5432

# For tools run on the host. Containers do not use this: inside the compose network the
# database is reached as `postgres`, and docker-compose.yml builds that URL itself.
DATABASE_URL=postgres://emp_user:emp_password@localhost:5432/event_management_platform?sslmode=disable
